# Normalise text files in the repository (LF), keep binaries untouched.
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.cpp   text eol=lf
*.hpp   text eol=lf
*.ps1   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

*.png   binary
*.jpg   binary
*.ttf   binary
*.wav   binary
*.deb   binary